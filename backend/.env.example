NODE_ENV=development
PORT=3000

DB_HOST=postgres
DB_PORT=5432
DB_USER=pwa_user
DB_PASSWORD=pwa_pass
DB_NAME=pwa_db

# Pool de conexiones y timeouts (defensa ante DB lenta → conexiones acumuladas).
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=12000
DB_IDLE_TX_TIMEOUT_MS=15000

REDIS_HOST=redis
REDIS_PORT=6379
# Genera uno con: openssl rand -base64 32
REDIS_PASSWORD=change_me_redis_password

JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PWA App
WEBAUTHN_ORIGIN=http://localhost:5173

# Escape de emergencia: habilita CORS en NestJS aunque Kong ya lo maneje (debugging directo al :3000).
ENABLE_NESTJS_CORS=false

# En producción: SEED_DEMO_DATA=false (evita crear usuarios/clientes demo con password conocida).
SEED_DEMO_DATA=false
# Password de los usuarios demo (solo dev, ¡cámbiala!). Mínimo 8 caracteres.
SEED_DEMO_PASSWORD=change_me_demo_password

# Rol de aplicación NO owner para que la RLS aplique de verdad (NOBYPASSRLS).
# Opcional: si se define, el runtime se conecta con este rol en vez del owner.
# Déjalas vacías para conectar con DB_USER (comportamiento actual).
# La migración 1700000015000-RlsHardening crea el rol y aplica FORCE RLS.
DB_APP_USER=
DB_APP_PASSWORD=

# Algoritmo de estudio de crédito (Saman). Sin SAMAN_API_URL funciona en modo
# simulado: confiabilidad >= 3 pre-aprueba tras SAMAN_SIMULATED_DELAY_MS
# (súbelo por encima de 60000 para probar la validación en segundo plano).
SAMAN_API_URL=
SAMAN_API_KEY=
SAMAN_SIMULATED_DELAY_MS=20000
# Cada cuánto se resuelven en segundo plano los borradores pendientes (0 = desactivado).
CREDIT_STUDY_POLL_INTERVAL_MS=30000
