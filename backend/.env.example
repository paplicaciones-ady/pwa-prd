NODE_ENV=development
PORT=3000

DB_HOST=postgres
DB_PORT=5432
DB_USER=pwa_user
DB_PASSWORD=pwa_pass
DB_NAME=pwa_db

# Pool de conexiones y timeouts (defensa ante DB lenta → conexiones acumuladas).
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_QUERY_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=12000
DB_IDLE_TX_TIMEOUT_MS=15000

REDIS_HOST=redis
REDIS_PORT=6379
# Genera uno con: openssl rand -base64 32
REDIS_PASSWORD=change_me_redis_password

JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=PWA App
WEBAUTHN_ORIGIN=http://localhost:5173

# Escape de emergencia: habilita CORS en NestJS aunque Kong ya lo maneje (debugging directo al :3000).
ENABLE_NESTJS_CORS=false

# En producción: SEED_DEMO_DATA=false (evita crear usuarios/clientes demo con password conocida).
SEED_DEMO_DATA=false
# Password de los usuarios demo (solo dev, ¡cámbiala!). Mínimo 8 caracteres.
SEED_DEMO_PASSWORD=change_me_demo_password

# Rol de aplicación NO owner para que la RLS aplique de verdad (NOBYPASSRLS).
# Opcional: si se define, el runtime se conecta con este rol en vez del owner.
# Déjalas vacías para conectar con DB_USER (comportamiento actual).
# La migración 1700000015000-RlsHardening crea el rol y aplica FORCE RLS.
DB_APP_USER=
DB_APP_PASSWORD=

# Algoritmo de estudio de crédito (Saman).
#   SAMAN_API_URL  base del servicio, sin /api/v1. El backend usa:
#                    POST {SAMAN_API_URL}/api/v1/check/async      (crea la tarea → task_id)
#                    GET  {SAMAN_API_URL}/api/v1/check/{task_id}  (RUNNING | COMPLETED | FAILED)
#                  Vacía = modo simulado (ver SAMAN_SIMULATED_*).
#   SAMAN_API_KEY  token de API; se envía como "Authorization: Bearer <token>".
#                  Rotación MANUAL: crear el token nuevo en Saman, ponerlo aquí,
#                  reiniciar el backend y revocar el anterior en Saman. Si vence
#                  o se revoca, Saman responde 401/403 y la app avisa; las
#                  solicitudes quedan en validación hasta que se cambie.
#   SAMAN_HTTPS_PROXY  proxy de salida con lista blanca. El backend no tiene
#                  salida directa a Internet: docker-compose la fija en
#                  http://egress-proxy:3128 (ver egress-proxy/squid.conf, donde
#                  debe estar el dominio de SAMAN_API_URL). Vacía = conexión directa.
#   SAMAN_EMPRESA  valor del campo "empresa" de la petición (ej. ADYLOG).
#   SAMAN_EXTERNAS valor del campo "externas" de la petición (true/false).
#   SAMAN_TASK_MAX_AGE_HOURS  horas tras las que una tarea sin veredicto se da por perdida.
#   El cupo pre-aprobado es check.recommended_limit (si llega en 0 se trata como error).
#   SAMAN_SIMULATED_DELAY_MS  solo modo simulado: ms hasta el veredicto (>60000 prueba el segundo plano).
#   SAMAN_SIMULATED_RESULT    solo modo simulado: approved | rejected | failed.
SAMAN_API_URL=
SAMAN_API_KEY=
SAMAN_HTTPS_PROXY=
SAMAN_EMPRESA=ADYLOG
SAMAN_EXTERNAS=false
SAMAN_TASK_MAX_AGE_HOURS=24
SAMAN_SIMULATED_DELAY_MS=20000
SAMAN_SIMULATED_RESULT=approved
# Cada cuánto se resuelven en segundo plano los borradores pendientes (0 = desactivado).
CREDIT_STUDY_POLL_INTERVAL_MS=30000
